{
  "name": "Rust Development",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb"
      ]
    }
  },

  "postCreateCommand": "rustc --version && cargo --version",
  
  "remoteUser": "vscode"
}
